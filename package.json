{
  "name": "omnitide",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "testnet:verification": "pnpm --silent --filter @omnitide/contracts testnet:verification",
    "mainnet:verification": "pnpm --silent --filter @omnitide/contracts mainnet:verification",
    "mainnet:v2:verification": "pnpm --silent --filter @omnitide/contracts mainnet:v2:verification"
  },
  "devDependencies": {
    "turbo": "2.11.12",
    "typescript": "5.9.3"
  }
}
