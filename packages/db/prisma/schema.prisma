generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  // extensionless imports resolve under Turbopack, esbuild and tsc bundler resolution alike
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// OHLC candles built by the keeper from live venue prices (USD, 1e-8 precision as Decimal).
model Candle {
  feed     String
  interval Int      @db.SmallInt // seconds: 60, 900, 3600
  start    DateTime @db.Timestamptz(3)
  open     Decimal  @db.Decimal(24, 8)
  high     Decimal  @db.Decimal(24, 8)
  low      Decimal  @db.Decimal(24, 8)
  close    Decimal  @db.Decimal(24, 8)
  ticks    Int      @default(1)

  @@id([feed, interval, start])
  @@index([feed, interval, start(sort: Desc)])
}

/// Latest price per feed plus its venue, for the markets board and health checks.
model PriceLatest {
  feed      String   @id
  price     Decimal  @db.Decimal(24, 8)
  source    String
  observed  DateTime @db.Timestamptz(3)
  change24h Decimal? @db.Decimal(12, 6)
}

/// Liveness of background services (keeper loops), read by /api/health.
model Heartbeat {
  service String   @id
  beatAt  DateTime @db.Timestamptz(3)
  detail  Json?
}

/// Account equity every few minutes, taken by the keeper for the History equity curve and PnL reports (tdUSD).
model AccountSnapshot {
  account     String // lowercase 0x address
  at          DateTime @db.Timestamptz(3)
  equity      Decimal  @db.Decimal(24, 6)
  collateral  Decimal  @db.Decimal(24, 6)
  upnl        Decimal  @db.Decimal(24, 6)
  notional    Decimal  @db.Decimal(24, 6)
  maintenance Decimal  @db.Decimal(24, 6)

  @@id([account, at])
}

/// Harbor vault size and share supply over time; share price = totalAssets / totalSupply.
model HarborSnapshot {
  at          DateTime @id @db.Timestamptz(3)
  totalAssets Decimal  @db.Decimal(24, 6)
  totalSupply Decimal  @db.Decimal(24, 6)
}

/// Riptide Alerts: one subscription per account and channel, signed by the account owner.
model AlertSubscription {
  id         String    @id @default(cuid())
  account    String // lowercase 0x address
  channel    String // push | telegram | email
  target     Json // push subscription, { email }, or { code, chatId }
  threshold  Float // alert when the tide gauge level falls below this (0..1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSentAt DateTime? @db.Timestamptz(3)
  lastLevel  Float?

  @@unique([account, channel])
}

/// Deep Mode sealed ledger: one private book per Deep id. Only the keeper holds plaintext; the chain holds commitments.
model DeepBook {
  id          String   @id // bytes32 Deep id, lowercase hex
  owner       String? // lowercase 0x address, known once the owner registers
  salt        String?
  viewKey     String? // x25519 public key the book is sealed to
  book        Json
  intentNonce Int      @default(0)
  dirty       Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([owner])
}

/// Chain events the keeper has already applied (txHash:logIndex), so a rescan never credits twice.
model AppliedEvent {
  key String   @id
  at  DateTime @default(now()) @db.Timestamptz(3)
}

/// Block cursors for keeper log scans.
model Cursor {
  name  String @id
  block BigInt
}
